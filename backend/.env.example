# Copy to .env locally. Use Supabase > Database > Connect for the full URI.
APP_NAME=MatrixFlow Enterprise API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT-REF>:<URL-ENCODED-PASSWORD>@<SESSION-POOLER-HOST>:5432/postgres?sslmode=require
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32-output
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173"]